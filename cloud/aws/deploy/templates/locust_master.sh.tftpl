#!/bin/bash
set -euo pipefail

export HOME=/root
exec > /var/log/locust-setup.log 2>&1

# --- Install git ---
dnf install -y git

# --- Install uv ---
curl -LsSf https://astral.sh/uv/install.sh | sh
export PATH="/root/.local/bin:$PATH"
echo 'export PATH="/root/.local/bin:$PATH"' >> /etc/profile.d/uv.sh

# --- Install Python 3.13 via uv ---
uv python install 3.13

# --- Clone repo ---
cd /opt
git clone --branch ${repo_branch} ${repo_url} codabench-loadtest
cd codabench-loadtest

# --- Install dependencies ---
uv sync

# --- Write environment config ---
cat > .github/env/prod.env <<'ENVEOF'
CODABENCH_HOST=http://${codabench_app_ip}
CODABENCH_CADDY_HOSTNAME=localhost
CODABENCH_USERNAME=${codabench_username}
CODABENCH_PASSWORD=${codabench_password}
CODABENCH_RABBITMQ_URL=http://${codabench_app_ip}:15672
CODABENCH_RABBITMQ_USER=${rabbitmq_user}
CODABENCH_RABBITMQ_PASSWORD=${rabbitmq_password}
LOCUST_REGION=${region_name}
RESULTS_BUCKET=${results_bucket}
ENVEOF

# --- Write locust.conf ---
cat > locust.conf <<'LOCUSTEOF'
locustfile = codabench_loadtest/locustfile.py
master = true
env = prod
host = http://${alb_dns}
web-host = 0.0.0.0
LOCUSTEOF

# --- Start Locust master ---
nohup uv run locust &>> /var/log/locust.log &

echo "Locust master started"
