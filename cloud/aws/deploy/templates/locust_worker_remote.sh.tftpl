#!/bin/bash
set -euo pipefail

exec > /var/log/locust-setup.log 2>&1

# --- Install git + AWS CLI ---
dnf install -y git aws-cli

# --- Install uv ---
curl -LsSf https://astral.sh/uv/install.sh | sh
export HOME=/root
export PATH="/root/.local/bin:$PATH"
echo 'export PATH="/root/.local/bin:$PATH"' >> /etc/profile.d/uv.sh

# --- Install Python 3.13 via uv ---
uv python install 3.13

# --- Clone repo ---
cd /opt
git clone --branch ${repo_branch} ${repo_url} codabench-loadtest
cd codabench-loadtest

# --- Install dependencies ---
uv sync

# --- Write environment config ---
cat > .env <<'ENVEOF'
CODABENCH_HOST=http://${alb_dns}
CODABENCH_USERNAME=${codabench_username}
CODABENCH_PASSWORD=${codabench_password}
LOCUST_REGION=${region_name}
RESULTS_BUCKET=${results_bucket}
ENVEOF

cp .env .github/env/prod.env

# --- Start Locust worker (connects to master via NLB) ---
uv run locust \
  -f codabench_loadtest/locustfile.py \
  --worker \
  --master-host ${master_nlb_dns} \
  --host "http://${alb_dns}" \
  &>> /var/log/locust.log &

echo "Locust worker started (${region_name}), master=${master_nlb_dns}"
