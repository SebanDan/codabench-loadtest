#!/bin/bash
set -euo pipefail

exec > /var/log/locust-setup.log 2>&1

# --- Install git + AWS CLI ---
dnf install -y git aws-cli

# --- Install uv ---
curl -LsSf https://astral.sh/uv/install.sh | sh
export HOME=/root
export PATH="/root/.local/bin:$PATH"
echo 'export PATH="/root/.local/bin:$PATH"' >> /etc/profile.d/uv.sh

# --- Install Python 3.13 via uv ---
uv python install 3.13

# --- Clone repo ---
cd /opt
git clone --branch ${repo_branch} ${repo_url} codabench-loadtest
cd codabench-loadtest

# --- Install dependencies ---
uv sync

# --- Write environment config ---
cat > .env <<'ENVEOF'
CODABENCH_HOST=http://${alb_dns}
LOCUST_REGION=${region_name}
RESULTS_BUCKET=${results_bucket}
ENVEOF

# Remote workers do NOT auto-start Locust.
# Runs are triggered manually via SSM:
#
#   cd /opt/codabench-loadtest && uv run locust \
#     -f codabench_loadtest/locustfile.py \
#     --host "http://${alb_dns}" \
#     --headless --users 100 --run-time 15m \
#     --csv runs/<run-name>_${region_name}

echo "Remote worker ready (${region_name}). Locust NOT started — trigger manually via SSM."
